{
	"name": "@ribbonette/code",
	"author": "HAKUMI",
	"repository": "https://github.com/hakusoda/ribbon.git",
	"license": "AGPL-3.0-only",
	"private": true,
	"version": "0.0.0",
	"scripts": {
		"backend:build": "turbo run build --filter=@ribbonette/backend",
		"backend:dev": "turbo run dev --filter=@ribbonette/backend",
		"web:build": "turbo run build --filter=@ribbonette/frontend",
		"web:dev": "turbo run dev --filter=@ribbonette/frontend",
		"build": "turbo run build --continue"
	},
	"workspaces": [
		"crates/ribbon",
		"packages/*"
	],
	"devDependencies": {
		"turbo": "^2.6.1"
	},
	"packageManager": "yarn@4.11.0"
}
